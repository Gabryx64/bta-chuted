{
	"schemaVersion": 1,
	"id": "examplemod",
	"version": "${version}",
	"name": "Example Mod",
	"description": "This mod aims to help new BTA modders.",
	"authors": [
		"Turnip Labs"
	],
	"contact": {
		"homepage": "",
		"sources": ""
	},
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotori_scala",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		],
		"beforeGameStart": [
			{
				"adapter": "kotori_scala",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		],
		"afterGameStart": [
			{
				"adapter": "kotori_scala",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		],
		"recipesReady": [
			{
				"adapter": "kotori_scala",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		]
	},
	"mixins": [
		"examplemod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.5",
		"kotori_scala": ">=2.1.0"
	},
	"suggests": {}
}
